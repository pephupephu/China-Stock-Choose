# China-Stock-Choose environment template. Copy to .env (git-ignored) and fill in.

# AKShare / general proxy (CN investors may need this; leave empty if direct)
AKSHARE_PROXY=http://127.0.0.1:10808
# HTTPS_PROXY / HTTP_PROXY honoured too

# Cache location (relative paths OK)
CACHE_DIR=output/.cache
CACHE_TTL_SECONDS=21600

# Tushare PRO token (optional, used for cross-verification)
TUSHARE_TOKEN=

# Screener thresholds
RULE_MIN_DIVIDEND_YIELD_PCT=4.0
RULE_MAX_PE_TTM=30.0
RULE_MAX_DEBT_RATIO_PCT=70.0
RULE_MAX_REVENUE_DECLINE_PCT=20.0
RULE_MIN_PAYOUT_RATIO_PCT=40.0
RULE_MIN_ROE_PCT=10.0

# Email (QQ / 163 / Gmail)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=your_account@qq.com
SMTP_PASSWORD=your_app_specific_password
EMAIL_SENDER=your_account@qq.com
EMAIL_RECIPIENTS=your_account@example.com,friend@example.com
EMAIL_SUBJECT_PREFIX=[China-Stock-Choose]

# Misc
TOP_N=50
LOG_LEVEL=INFO